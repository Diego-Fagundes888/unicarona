# Copy to .env. Never use these development settings for public deployment.
NODE_ENV=
HOST=
PORT=
APP_ORIGIN=
DATABASE_URL=
DB_POOL_MAX=
DB_STATEMENT_TIMEOUT_MS=
SESSION_ACCESS_MINUTES=
SESSION_REFRESH_DAYS=
TOKEN_PEPPER=
PIN_ENCRYPTION_KEY=
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
# Orders API: use a seller test account, never infer environment from APP_USR.
MERCADO_PAGO_ENVIRONMENT=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# Valor vazio; configure somente no ambiente privado.
MERCADO_PAGO_MARKETPLACE_APPROVED=
PAYMENT_PROVIDER_TIMEOUT_MS=
EMAIL_PROVIDER=
# development | resend | smtp. Credenciais permanecem somente no backend.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
EMAIL_VERIFICATION_MINUTES=
# Em produção, configurar URLs HTTPS reais de suporte e política de privacidade.
EMAIL_SUPPORT_URL=
EMAIL_PRIVACY_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
STORAGE_PATH=
# Operational limits per account, including retained document history.
STORAGE_USER_QUOTA_BYTES=
STORAGE_USER_MAX_FILES=
DEV_MAIL_PATH=
SEED_PASSWORD=
# Docker PostgreSQL initialization. Generate separate strong random secrets.
PG_SUPERUSER_PASSWORD=
PG_APP_PASSWORD=
REQUEST_EXPIRY_HOURS=
CHECKOUT_EXPIRY_MINUTES=

# Java authentication and isolated Testcontainers/local verification.
JWT_SECRET=
UNICARONA_MODE=
TEST_JAVA_DATABASE_URL=
JAVA_DATABASE_URL=
JAVA_HTTP_PORT=

# Public legal context; review before enabling a real operation.
LEGAL_CONTROLLER_NAME=
LEGAL_PRIVACY_EMAIL=
LEGAL_CITY=
LEGAL_STATE=
LEGAL_COMMERCIAL_OPERATION=
