# Fragmento para testes de baixo volume com uma conta Gmail autorizada.
# Complete banco/autenticação/worker conforme .env.example. Não coloque a senha normal do Google.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_VERIFICATION_MINUTES=
WORKER_IDLE_MS=
# A senha de app deve ser gerada e salva pelo titular, somente no .env privado.
# Para links acessíveis aos alunos, APP_ORIGIN precisa ser uma URL pública da aplicação.
