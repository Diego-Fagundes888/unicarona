# Mesclar com a configuração privada da aplicação; nunca versionar os valores reais.
# O backend Java lê environment variables ou .env no diretório de execução.
# O banco, pepper e chave AES permanecem os mesmos para manter os dados compatíveis.
DATABASE_URL=
TOKEN_PEPPER=
PIN_ENCRYPTION_KEY=
# Novo segredo exclusivo para assinatura JWT, mínimo 32 bytes UTF-8.
JWT_SECRET=
APP_ORIGIN=
HOST=
PORT=
NODE_ENV=
UNICARONA_MODE=
# Comandos de demonstração: seed ou seed-scenarios; proibidos em production.
# Definir apenas no ambiente privado, com pelo menos 16 caracteres; não há senha padrão.
SEED_PASSWORD=
# No processo worker: manutenção imediata e depois a cada 15 s; fila vazia aguarda 1 s.
WORKER_MAINTENANCE_INTERVAL_MS=
WORKER_IDLE_MS=
WORKER_SHUTDOWN_TIMEOUT_MS=
SESSION_ACCESS_MINUTES=
SESSION_REFRESH_DAYS=
PAYMENT_PROVIDER=
# Para Orders API, mantenha credenciais somente no backend.
MERCADO_PAGO_ENVIRONMENT=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# Somente após validação comercial da retenção e dos repasses do marketplace.
MERCADO_PAGO_MARKETPLACE_APPROVED=
# Segredo do webhook já usado pelo backend atual, mínimo 32 caracteres.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER_TIMEOUT_MS=
EMAIL_PROVIDER=
# Resend: configure a chave no arquivo privado, nunca no navegador.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
EMAIL_VERIFICATION_MINUTES=
EMAIL_SUPPORT_URL=
EMAIL_PRIVACY_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Diretório privado, separado de FRONTEND_PATH/dist.
STORAGE_PATH=
STORAGE_USER_QUOTA_BYTES=
STORAGE_USER_MAX_FILES=

# Independent inventory outside active uploads and FRONTEND_PATH; production requires initialization.
PRIVACY_OPERATIONS_ROOT=
# Different keys per purpose. JSON map key-id -> random base64url secret (32+ random bytes).
# Keep verification keys until all dependent records and recovery copies have been rekeyed/expired.
PRIVACY_BACKUP_KEY_ID=
PRIVACY_BACKUP_KEYS=
PRIVACY_JOURNAL_KEY_ID=
PRIVACY_JOURNAL_KEYS=
# AES-256 evidence ring: JSON key-id -> 64 hexadecimal characters. Separate from PIN/financial keys.
# Keep earlier keys while any retained record or recoverable backup still requires them.
PRIVACY_EVIDENCE_KEY_ID=
PRIVACY_EVIDENCE_KEYS=

# compose.java.yaml: banco e volumes próprios para desenvolvimento.
# Preencher os valores no arquivo privado; nunca copiar credenciais reais para cá.
PG_SUPERUSER_PASSWORD=
PG_APP_PASSWORD=
# postgres://unicarona:<senha com escape URI>@db:5432/unicarona
JAVA_DATABASE_URL=
JAVA_HTTP_PORT=
